{
  "expo": {
    "name": "Medutis",
    "slug": "medutis-dating",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "medutis",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lt.medutis.dating"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B9D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "lt.medutis.dating"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ]
  }
}
