{
  "expo": {
    "name": "Medutis",
    "slug": "medutis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "medutis",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lt.medutis.dating"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B9D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "lt.medutis.dating"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "5cc5c987-aa7f-4a77-bae1-e3e45bfb498d"
      }
    },
    "owner": "medutis"
  }
}
